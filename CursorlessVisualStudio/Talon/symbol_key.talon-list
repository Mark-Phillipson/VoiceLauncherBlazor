list: user.symbol_key
-

dot: .
comma: ,
colon: :
semi: ;
quote: '
double quote: "
slash: /
backslash: \
dash: -
under: _
plus: +
equal: =
bang: !
quest: ?
at: @
hash: #
dollar: $
percent: %
