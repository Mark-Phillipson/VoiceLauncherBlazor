<platform:DialogWindow x:Class="CursorlessVisualStudio.SelectHatDialog" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:platform="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
    Title="Select Cursorless Hat" Width="420" SizeToContent="Height" ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock Text="Enter the exact marked character (A and a differ)." TextWrapping="Wrap" Margin="0,0,0,8" />
        <Label Content="_Character:" Target="{Binding ElementName=CharacterInput}" />
        <TextBox x:Name="CharacterInput" AutomationProperties.Name="Marked character, case sensitive" />
        <Label Content="C_olor:" Target="{Binding ElementName=ColorInput}" />
        <ComboBox x:Name="ColorInput" AutomationProperties.Name="Hat color" />
        <Label Content="S_hape:" Target="{Binding ElementName=ShapeInput}" />
        <ComboBox x:Name="ShapeInput" AutomationProperties.Name="Hat shape" />
        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Assertive" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="_Select" IsDefault="True" Click="SelectClick" MinWidth="80" Margin="0,0,8,0" />
            <Button Content="Ca_ncel" IsCancel="True" MinWidth="80" />
        </StackPanel>
    </StackPanel>
</platform:DialogWindow>
