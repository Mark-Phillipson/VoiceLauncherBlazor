@using Microsoft.AspNetCore.Components.Web
@inject FolderWalkerService FolderWalker

<div class="container-fluid p-4">
    <header class="mb-4">
        <h1 class="h3 mb-1">Folder Walker</h1>
        <p class="text-secondary mb-0">Find folders by name on a drive, then choose one to use.</p>
    </header>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-4">
                    <label class="form-label fw-semibold" for="drive-select">Drive</label>
                    <select id="drive-select" class="form-select" @bind="_selectedRoot" disabled="@_isSearching">
                        @foreach (var drive in _drives)
                        {
                            <option value="@drive.RootPath">@drive.DisplayName</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label fw-semibold" for="folder-search">Folder name contains</label>
                    <input id="folder-search"
                           class="form-control"
                           placeholder="For example, Documents"
                           @bind="_searchText"
                           @bind:event="oninput"
                           @onkeydown="HandleSearchKeyDown"
                           disabled="@_isSearching" />
                </div>
                <div class="col-12 col-md-2 d-grid">
                    @if (_isSearching)
                    {
                        <button class="btn btn-outline-secondary" @onclick="CancelSearch">Cancel</button>
                    }
                    else
                    {
                        <button class="btn btn-primary"
                                @onclick="SearchAsync"
                                disabled="@(!CanSearch)">
                            Search
                        </button>
                    }
                </div>
            </div>
            @if (_drives.Count == 0)
            {
                <div class="alert alert-warning mt-3 mb-0">No ready drives were found.</div>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger" role="alert">@_errorMessage</div>
    }
    @if (_selectionConfirmed && !string.IsNullOrWhiteSpace(_selectedFolder))
    {
        <div class="alert alert-success" role="status">
            Selected folder: <span class="fw-semibold text-break">@_selectedFolder</span>
        </div>
    }

    @if (_isSearching)
    {
        <div class="d-flex align-items-center gap-2 text-secondary mb-3" role="status">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            <span>Searching folders…</span>
        </div>
    }

    @if (_searchResults is not null)
    {
        <section class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 px-4 pt-4">
                <div class="d-flex justify-content-between align-items-start gap-3">
                    <div>
                        <h2 class="h5 mb-1">Results</h2>
                        <p class="text-secondary mb-0">
                            @_searchResults.Folders.Count folder(s) found
                            @if (_searchResults.SkippedFolderCount > 0)
                            {
                                <span> · @_searchResults.SkippedFolderCount folder(s) could not be read</span>
                            }
                        </p>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_selectedFolder))
                    {
                        <button class="btn btn-success flex-shrink-0" @onclick="UseSelectedFolderAsync">
                            Use selected folder
                        </button>
                    }
                </div>
            </div>
            <div class="card-body px-4 pt-2">
                @if (_searchResults.Folders.Count > 0)
                {
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <span class="small text-secondary">
                            Showing @(_currentPage * PageSize + 1)–@Math.Min((_currentPage + 1) * PageSize, _searchResults.Folders.Count)
                            of @_searchResults.Folders.Count
                        </span>
                        @if (PageCount > 1)
                        {
                            <div class="btn-group" role="group" aria-label="Folder result pages">
                                <button type="button" class="btn btn-outline-secondary"
                                        @onclick="() => ChangePage(-1)" disabled="@(_currentPage == 0)">
                                    Previous
                                </button>
                                <button type="button" class="btn btn-outline-secondary"
                                        @onclick="() => ChangePage(1)" disabled="@(_currentPage >= PageCount - 1)">
                                    Next
                                </button>
                            </div>
                        }
                    </div>
                    <div class="d-flex flex-wrap gap-2 mb-3" aria-label="Quick folder selection">
                        @for (var i = 0; i < Math.Min(CurrentPageFolders.Count, 9); i++)
                        {
                            var index = i;
                            var folder = CurrentPageFolders[index];
                            <button type="button"
                                    class="btn btn-outline-primary"
                                    @onclick="() => SelectAndUseFolderAsync(folder)">
                                Select @OrdinalLabels[index]
                            </button>
                        }
                    </div>
                }

                @if (_searchResults.Folders.Count == 0)
                {
                    <p class="text-secondary py-3 mb-0">No folders matched “@_searchText”.</p>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var folder in CurrentPageFolders)
                        {
                            <button @key="folder"
                                    type="button"
                                    class="list-group-item list-group-item-action text-start py-3 @(string.Equals(folder, _selectedFolder, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)"
                                    aria-pressed="@string.Equals(folder, _selectedFolder, StringComparison.OrdinalIgnoreCase)"
                                    @onclick="() => SelectFolder(folder)">
                                <span class="d-block fw-semibold">@System.IO.Path.GetFileName(folder)</span>
                                <span class="d-block small text-secondary text-break">@folder</span>
                            </button>
                        }
                    </div>
                }
            </div>
        </section>
    }
</div>

@code {
    [Parameter] public EventCallback<string> FolderSelected { get; set; }

    private const int PageSize = 100;
    private static readonly string[] OrdinalLabels = ["1st", "2nd", "3rd", "4th", "5th", "6th", "7th", "8th", "9th"];
    private readonly List<DriveOption> _drives = [];
    private string? _selectedRoot;
    private string _searchText = string.Empty;
    private string? _selectedFolder;
    private FolderSearchResult? _searchResults;
    private CancellationTokenSource? _searchCancellation;
    private string? _errorMessage;
    private bool _isSearching;
    private bool _selectionConfirmed;
    private int _currentPage;

    private int PageCount => _searchResults is null
        ? 0
        : (int)Math.Ceiling(_searchResults.Folders.Count / (double)PageSize);

    private IReadOnlyList<string> CurrentPageFolders => _searchResults is null
        ? Array.Empty<string>()
        : _searchResults.Folders.Skip(_currentPage * PageSize).Take(PageSize).ToArray();

    private bool CanSearch =>
        !string.IsNullOrWhiteSpace(_selectedRoot) &&
        !string.IsNullOrWhiteSpace(_searchText);

    protected override void OnInitialized()
    {
        try
        {
            foreach (var drive in DriveInfo.GetDrives())
            {
                try
                {
                    if (!drive.IsReady)
                        continue;

                    var label = string.IsNullOrWhiteSpace(drive.VolumeLabel)
                        ? drive.Name
                        : $"{drive.Name} ({drive.VolumeLabel})";
                    _drives.Add(new DriveOption(drive.Name, label));
                }
                catch (IOException)
                {
                    // A removable drive can disappear while the list is being populated.
                }
                catch (UnauthorizedAccessException)
                {
                    // Keep other drives available when one drive cannot be inspected.
                }
            }
        }
        catch (IOException)
        {
            _errorMessage = "The available drives could not be read.";
        }

        _drives.Sort((left, right) => StringComparer.OrdinalIgnoreCase.Compare(left.RootPath, right.RootPath));
        _selectedRoot = _drives.FirstOrDefault()?.RootPath;
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && CanSearch && !_isSearching)
            await SearchAsync();
    }

    private async Task SearchAsync()
    {
        if (!CanSearch)
            return;

        _searchCancellation?.Cancel();
        _searchCancellation?.Dispose();
        _searchCancellation = new CancellationTokenSource();
        _isSearching = true;
        _errorMessage = null;
        _selectedFolder = null;
        _selectionConfirmed = false;
        _currentPage = 0;
        _searchResults = null;

        try
        {
            _searchResults = await FolderWalker.SearchAsync(
                _selectedRoot!,
                _searchText,
                _searchCancellation.Token);
        }
        catch (OperationCanceledException)
        {
            _errorMessage = "The folder search was cancelled.";
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or ArgumentException)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isSearching = false;
            _searchCancellation?.Dispose();
            _searchCancellation = null;
        }
    }

    private void CancelSearch() => _searchCancellation?.Cancel();

    private void ChangePage(int pageDelta)
    {
        _currentPage = Math.Clamp(_currentPage + pageDelta, 0, Math.Max(0, PageCount - 1));
        _selectedFolder = null;
        _selectionConfirmed = false;
    }

    private void SelectFolder(string folderPath)
    {
        _selectedFolder = folderPath;
        _selectionConfirmed = false;
    }

    private async Task SelectAndUseFolderAsync(string folderPath)
    {
        SelectFolder(folderPath);
        await UseSelectedFolderAsync();
    }

    private async Task UseSelectedFolderAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedFolder))
            return;

        await FolderSelected.InvokeAsync(_selectedFolder);
        _selectionConfirmed = true;
    }

    private sealed record DriveOption(string RootPath, string DisplayName);
}
