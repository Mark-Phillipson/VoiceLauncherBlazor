@using Microsoft.AspNetCore.Components.Web
@implements IDisposable
@inject FolderWalkerService FolderWalker

<style>
    .folder-walker-result-list {
        --folder-shortcut-width: 112px;
    }

    .folder-result-shortcut,
    .folder-result-shortcut-placeholder {
        width: var(--folder-shortcut-width);
    }

    .folder-result-item {
        background-color: #212529;
        color: #f8f9fa;
        border-color: #495057;
    }

    .folder-result-item:hover,
    .folder-result-item:focus-visible {
        background-color: #343a40;
        color: #fff;
    }

    .folder-result-item.active {
        background-color: #0d6efd;
        border-color: #0d6efd;
        color: #fff;
    }

    .folder-result-path {
        color: #adb5bd !important;
    }
</style>

<div class="container-fluid p-4">
    <header class="mb-4">
        <h1 class="h3 mb-1">Folder Walker</h1>
        <p class="text-secondary mb-0">Find folders by name on a drive, then choose one to use.</p>
    </header>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-4">
                    <label class="form-label fw-semibold" for="drive-select">Drive</label>
                    <select id="drive-select" class="form-select" value="@_selectedRoot" @onchange="OnDriveChanged">
                        @foreach (var drive in _drives)
                        {
                            <option value="@drive.RootPath" disabled="@(!drive.IsReady)">@drive.DisplayName</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label fw-semibold" for="folder-search">Folder name contains</label>
                    <input id="folder-search"
                           @ref="_searchInput"
                           class="form-control"
                           placeholder="For example, Documents"
                           value="@_searchText"
                           @oninput="OnSearchTextChanged"
                           @onkeydown="HandleSearchKeyDown" />
                </div>
                <div class="col-12 col-md-2 d-grid">
                    @if (_isSearching)
                    {
                        <button class="btn btn-outline-secondary" @onclick="() => CancelSearch()">Cancel</button>
                    }
                    else
                    {
                        <button class="btn btn-primary"
                                @onclick="() => SearchAsync()"
                                disabled="@(!CanSearch)">
                            Search
                        </button>
                    }
                </div>
            </div>
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-3">
                <div>
                    @if (!string.IsNullOrWhiteSpace(_indexStatusMessage))
                    {
                        <div class="small fw-semibold" role="status">@_indexStatusMessage</div>
                    }
                    <div class="small text-secondary">The drive index is saved locally. Refresh it after folder changes.</div>
                </div>
                <button class="btn btn-outline-secondary"
                        type="button"
                        @onclick="() => RefreshIndexAsync()"
                        disabled="@(_isIndexing || string.IsNullOrWhiteSpace(_selectedRoot))">
                    Refresh index
                </button>
            </div>
            @if (_isIndexing)
            {
                <div class="progress mt-2" aria-label="Building folder index">
                    <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 100%"></div>
                </div>
            }
            @if (!_drives.Any(drive => drive.IsReady))
            {
                <div class="alert alert-warning mt-3 mb-0">No ready drives were found.</div>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger" role="alert">@_errorMessage</div>
    }
    @if (_selectionConfirmed && !string.IsNullOrWhiteSpace(_selectedFolder))
    {
        <div class="alert alert-success" role="status">
            Selected folder: <span class="fw-semibold text-break">@_selectedFolder</span>
        </div>
    }

    @if (_isSearching)
    {
        <div class="d-flex align-items-center gap-2 text-secondary mb-3" role="status">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            <span>@(_isIndexing ? "Building the drive index…" : "Searching the index…")</span>
        </div>
    }

    @if (_searchResults is not null)
    {
        <section class="card border-secondary shadow-sm bg-dark text-light folder-walker-results">
            <div class="card-header bg-dark text-light border-secondary px-4 pt-4">
                <div class="d-flex justify-content-between align-items-start gap-3">
                    <div>
                        <h2 class="h5 mb-1">Results</h2>
                        <p class="text-secondary mb-0">
                            @_searchResults.Folders.Count folder(s) found
                            @if (_searchResults.SkippedFolderCount > 0)
                            {
                                <span> · @_searchResults.SkippedFolderCount folder(s) could not be read</span>
                            }
                        </p>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_selectedFolder))
                    {
                        <button class="btn btn-success flex-shrink-0" @onclick="UseSelectedFolderAsync">
                            Use selected folder
                        </button>
                    }
                </div>
            </div>
            <div class="card-body px-4 pt-2">
                @if (_searchResults.Folders.Count > 0)
                {
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <span class="small text-secondary">
                            Showing @(_currentPage * PageSize + 1)–@Math.Min((_currentPage + 1) * PageSize, _searchResults.Folders.Count)
                            of @_searchResults.Folders.Count
                        </span>
                        @if (PageCount > 1)
                        {
                            <div class="btn-group" role="group" aria-label="Folder result pages">
                                <button type="button" class="btn btn-outline-secondary"
                                        @onclick="() => ChangePage(-1)" disabled="@(_currentPage == 0)">
                                    Previous
                                </button>
                                <button type="button" class="btn btn-outline-secondary"
                                        @onclick="() => ChangePage(1)" disabled="@(_currentPage >= PageCount - 1)">
                                    Next
                                </button>
                            </div>
                        }
                    </div>
                }

                @if (_searchResults.Folders.Count == 0)
                {
                    <p class="text-secondary py-3 mb-0">No folders matched “@_searchText”.</p>
                }
                else
                {
                    <div class="d-grid gap-2 folder-walker-result-list">
                        @for (var i = 0; i < CurrentPageFolders.Count; i++)
                        {
                            var index = i;
                            var folder = CurrentPageFolders[index];
                            var folderName = System.IO.Path.GetFileName(folder);
                            <div @key="folder" class="d-flex align-items-stretch gap-2">
                                @if (index < 9)
                                {
                                    var shortcutNumber = index + 1;
                                    <button type="button"
                                            class="btn btn-outline-primary flex-shrink-0 folder-result-shortcut"
                                            accesskey="@shortcutNumber"
                                            aria-keyshortcuts="@shortcutNumber"
                                            aria-label="@($"Select and use folder {shortcutNumber}: {folder}")"
                                            @onclick="() => SelectAndUseFolderAsync(folder)">
                                        Select <u>@shortcutNumber</u>
                                    </button>
                                }
                                else
                                {
                                    <span class="flex-shrink-0 folder-result-shortcut-placeholder" aria-hidden="true"></span>
                                }
                                <button type="button"
                                        class="btn btn-outline-secondary flex-shrink-0 folder-result-copy"
                                        aria-label="@($"Copy folder path: {folder}")"
                                        @onclick="() => CopyFolderPath(folder)">
                                    @(string.Equals(_copiedFolderPath, folder, StringComparison.OrdinalIgnoreCase) ? "Copied" : "Copy")
                                </button>
                                <button type="button"
                                        class="list-group-item list-group-item-action text-start py-3 flex-grow-1 folder-result-item @(string.Equals(folder, _selectedFolder, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)"
                                        aria-pressed="@string.Equals(folder, _selectedFolder, StringComparison.OrdinalIgnoreCase)"
                                        aria-label="@($"Select folder {folderName}")"
                                        @onclick="() => SelectFolder(folder)">
                                    <span class="d-block fw-semibold text-break">@folderName</span>
                                    <span class="d-block small folder-result-path text-break">@folder</span>
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>
        </section>
    }
</div>

@code {
    [Parameter] public EventCallback<string> FolderSelected { get; set; }

    private readonly CancellationTokenSource _lifetimeCancellation = new();
    private ElementReference _searchInput;
    private const int PageSize = 100;
    private readonly List<DriveOption> _drives = [];
    private string? _selectedRoot;
    private string _searchText = string.Empty;
    private string? _selectedFolder;
    private string? _copiedFolderPath;
    private FolderSearchResult? _searchResults;
    private CancellationTokenSource? _searchCancellation;
    private string? _errorMessage;
    private string? _indexingRoot;
    private string? _indexStatusMessage;
    private int _indexedFolderCount;
    private bool _isIndexing;
    private bool _isSearching;
    private bool _selectionConfirmed;
    private int _currentPage;

    private int PageCount => _searchResults is null
        ? 0
        : (int)Math.Ceiling(_searchResults.Folders.Count / (double)PageSize);

    private IReadOnlyList<string> CurrentPageFolders => _searchResults is null
        ? Array.Empty<string>()
        : _searchResults.Folders.Skip(_currentPage * PageSize).Take(PageSize).ToArray();

    private bool CanSearch =>
        !string.IsNullOrWhiteSpace(_selectedRoot) &&
        !string.IsNullOrWhiteSpace(_searchText);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await _searchInput.FocusAsync();
    }

    protected override void OnInitialized()
    {
        try
        {
            foreach (var drive in DriveInfo.GetDrives())
            {
                try
                {
                    var isReady = drive.IsReady;
                    var label = !isReady
                        ? $"{drive.Name} (not ready)"
                        : string.IsNullOrWhiteSpace(drive.VolumeLabel)
                            ? drive.Name
                            : $"{drive.Name} ({drive.VolumeLabel})";
                    _drives.Add(new DriveOption(drive.Name, label, isReady));
                }
                catch (IOException)
                {
                    // Keep a drive visible if it disappears while the list is being populated.
                    _drives.Add(new DriveOption(drive.Name, $"{drive.Name} (not ready)", false));
                }
                catch (UnauthorizedAccessException)
                {
                    // Keep other drives available when one drive cannot be inspected.
                    _drives.Add(new DriveOption(drive.Name, $"{drive.Name} (not ready)", false));
                }
            }
        }
        catch (IOException)
        {
            _errorMessage = "The available drives could not be read.";
        }

        _drives.Sort((left, right) => StringComparer.OrdinalIgnoreCase.Compare(left.RootPath, right.RootPath));
        _selectedRoot = _drives.FirstOrDefault(drive => drive.IsReady)?.RootPath;
        if (_selectedRoot is not null)
            _ = EnsureDriveIndexAsync(_selectedRoot);
    }

    private Task OnSearchTextChanged(ChangeEventArgs args)
    {
        _searchText = args.Value?.ToString() ?? string.Empty;
        if (!CanSearch)
        {
            _searchCancellation?.Cancel();
            _searchCancellation = null;
            _isSearching = false;
            _searchResults = null;
            _selectedFolder = null;
            _selectionConfirmed = false;
            return Task.CompletedTask;
        }

        return SearchAsync(debounce: true);
    }

    private Task OnDriveChanged(ChangeEventArgs args)
    {
        _selectedRoot = args.Value?.ToString();
        _searchResults = null;
        _selectedFolder = null;
        _selectionConfirmed = false;

        if (_selectedRoot is not null)
            _ = EnsureDriveIndexAsync(_selectedRoot);

        return CanSearch ? SearchAsync(debounce: true) : Task.CompletedTask;
    }

    private async Task EnsureDriveIndexAsync(string rootPath, bool forceRefresh = false)
    {
        _indexingRoot = rootPath;
        _isIndexing = true;
        _indexedFolderCount = 0;
        _indexStatusMessage = forceRefresh ? "Refreshing the drive index…" : "Checking the saved drive index…";
        _errorMessage = null;

        var progress = new Progress<FolderWalkerIndexProgress>(update =>
        {
            if (_lifetimeCancellation.IsCancellationRequested ||
                !string.Equals(_selectedRoot, update.RootPath, StringComparison.OrdinalIgnoreCase))
                return;

            _indexedFolderCount = update.FolderCount;
            _indexStatusMessage = $"Indexing {update.RootPath}: {_indexedFolderCount:N0} folders found; {update.SkippedFolderCount:N0} inaccessible.";
            _ = InvokeAsync(StateHasChanged);
        });

        try
        {
            var summary = await FolderWalker.EnsureIndexAsync(
                rootPath,
                progress,
                _lifetimeCancellation.Token,
                forceRefresh);

            if (string.Equals(_selectedRoot, rootPath, StringComparison.OrdinalIgnoreCase))
            {
                _indexedFolderCount = summary.FolderCount;
                _indexStatusMessage = $"Index ready: {summary.FolderCount:N0} folders · updated {summary.IndexedAtUtc.ToLocalTime():g}";
            }
        }
        catch (OperationCanceledException)
        {
            // The window is closing.
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or ArgumentException or Microsoft.Data.Sqlite.SqliteException)
        {
            if (string.Equals(_selectedRoot, rootPath, StringComparison.OrdinalIgnoreCase))
                _errorMessage = $"The drive index could not be built: {exception.Message}";
        }
        finally
        {
            if (string.Equals(_indexingRoot, rootPath, StringComparison.OrdinalIgnoreCase))
                _isIndexing = false;
        }
    }

    private Task RefreshIndexAsync()
    {
        if (_selectedRoot is null || _isIndexing)
            return Task.CompletedTask;

        return EnsureDriveIndexAsync(_selectedRoot, forceRefresh: true);
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && CanSearch)
            await SearchAsync();
    }

    private async Task SearchAsync(bool debounce = false)
    {
        if (!CanSearch)
            return;

        _searchCancellation?.Cancel();
        var cancellation = new CancellationTokenSource();
        _searchCancellation = cancellation;
        var rootPath = _selectedRoot!;
        var searchText = _searchText;
        _isSearching = true;
        _errorMessage = null;
        _selectedFolder = null;
        _selectionConfirmed = false;
        _currentPage = 0;
        _searchResults = null;

        try
        {
            if (debounce)
                await Task.Delay(300, cancellation.Token);

            _searchResults = await FolderWalker.SearchAsync(
                rootPath,
                searchText,
                cancellation.Token);
        }
        catch (OperationCanceledException)
        {
            // A new query or a user cancellation stopped this search.
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or ArgumentException or Microsoft.Data.Sqlite.SqliteException)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            if (ReferenceEquals(_searchCancellation, cancellation))
            {
                _isSearching = false;
                _searchCancellation = null;
            }

            cancellation.Dispose();
        }
    }

    private void CancelSearch()
    {
        _errorMessage = "Search cancelled.";
        _searchCancellation?.Cancel();
    }

    private void ChangePage(int pageDelta)
    {
        _currentPage = Math.Clamp(_currentPage + pageDelta, 0, Math.Max(0, PageCount - 1));
        _selectedFolder = null;
        _selectionConfirmed = false;
    }

    private void SelectFolder(string folderPath)
    {
        _selectedFolder = folderPath;
        _selectionConfirmed = false;
    }

    private async Task SelectAndUseFolderAsync(string folderPath)
    {
        SelectFolder(folderPath);
        await UseSelectedFolderAsync();
    }

    private async Task UseSelectedFolderAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedFolder))
            return;

        await FolderSelected.InvokeAsync(_selectedFolder);
        _selectionConfirmed = true;
    }

    public void Dispose()
    {
        _lifetimeCancellation.Cancel();
        _searchCancellation?.Cancel();
        _lifetimeCancellation.Dispose();
    }

    private void CopyFolderPath(string folderPath)
    {
        try
        {
            System.Windows.Forms.Clipboard.SetText(folderPath);
            _copiedFolderPath = folderPath;
            _errorMessage = null;
        }
        catch (Exception exception) when (exception is System.Runtime.InteropServices.ExternalException or System.Threading.ThreadStateException or InvalidOperationException)
        {
            _errorMessage = $"The folder path could not be copied: {exception.Message}";
        }
    }

    private sealed record DriveOption(string RootPath, string DisplayName, bool IsReady);
}
