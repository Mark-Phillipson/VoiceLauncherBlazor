@page "/"
@using System.Diagnostics;
@using RazorClassLibrary.Pages
<CascadingBlazoredModal>
	<div class='m-2 text-center'>
		<details class="d-inline-block me-2 mb-1">
			<summary accesskey="&" class="btn btn-sm btn-outline-secondary"><u>&amp;</u> Window</summary>
			<div class="btn-group-vertical mt-1">
				<button accesskey="/" class="btn btn-sm btn-outline-secondary text-start" @onclick="@(() => MaximizeWindow())"><u>/</u> Maximize</button>
				<button accesskey="_" class="btn btn-sm btn-outline-secondary text-start" @onclick="@(() => MinimizeWindow())"><u>_</u> Minimize</button>
				<button accesskey="*" class="btn btn-sm btn-outline-secondary text-start" @onclick="@(() => RestoreWindow())"><u>*</u> Restore</button>
			</div>
		</details>
		<details class="d-inline-block me-2 mb-1">
			<summary accesskey="$" class="btn btn-sm btn-outline-info"><u>$</u> Data</summary>
			<div class="btn-group-vertical mt-1">
				<button accesskey="%" class="btn btn-sm btn-outline-info text-start" @onclick="@(() => RefreshCache())">
					<i class="bi bi-arrow-repeat"></i> <u>%</u> Refresh Data
				</button>
				<button accesskey="#" class="btn btn-sm btn-outline-secondary text-start" @onclick="@(() => ShowClipboardHistory())"><u>#</u> Clipboard History</button>
			</div>
		</details>
		<details class="d-inline-block mb-1">
			<summary accesskey="^" class="btn btn-sm btn-outline-primary"><u>^</u> Views</summary>
			<div class="btn-group-vertical mt-1">
				<button accesskey="&#64;" class="btn btn-sm btn-outline-primary text-start" @onclick="@(() => ShowAIChat())"><u>&#64;</u> AI @AIChatButtonCaption</button>
				@* Top-level switch buttons: show only the relevant toggle depending on current view *@
				@if (launcher)
				{
					<button accesskey="!" class="btn btn-sm btn-outline-secondary text-start" @onclick="SwitchToSnippetsFromChild"><i class="bi bi-box-arrow-up-right"></i> <u>!</u> Snippets</button>
				}
				else if (languageAndCategoryListing)
				{
					<button accesskey="!" class="btn btn-sm btn-outline-secondary text-start" @onclick="SwitchToLauncherFromChild"><i class="bi bi-box-arrow-up-right"></i> <u>!</u> Launcher</button>
				}
				else
				{
					<button accesskey="(" class="btn btn-sm btn-outline-secondary text-start" @onclick="SwitchToSnippetsFromChild"><u>(</u> Snippets</button>
					<button accesskey=")" class="btn btn-sm btn-outline-secondary text-start" @onclick="SwitchToLauncherFromChild"><u>)</u> Launcher</button>
				}
				<button accesskey="+" class="btn btn-sm btn-outline-success text-start" @onclick="@(() => ShowTalonSearch())"><u>+</u> @TalonSearchButtonCaption</button>
			</div>
		</details>
	</div>
	<div class='m-2'>
		@if (showAIChat)
		{
			<AIChatComponent RunningInBlazorHybrid="true" />
		}		else if (showTalonSearch)
		{
			<TalonVoiceCommandSearch IsBlazorHybrid="true" InitialSearchTerm="@searchTerm" />
		}
		else if (showClipboardHistory)
		{
			<ClipboardHistory />
		}
			else if (languageAndCategoryListing)
		{
			<CustomIntelliSenseTable @ref="customIntelliSenseTableRef" CategoryId="@categoryId" LanguageId="@languageId" RunningInBlazorHybrid="true"
				CloseApplication="CloseWindow" MaximizeApplication="MaximizeWindow" />
		}
			else if (launcher)
		{
			<LauncherTable @ref="launcherTableRef" CategoryId="@categoryId" CloseApplication="CloseWindow" RunningInBlazorHybrid="true"
				RefreshData="@refreshRequested" />
		}
		else // filtering by display value mostly
		{
			<CustomIntelliSenses @ref="customIntelliSensesRef" CategoryIdFilter="@categoryId" LanguageIdFilter="@languageId" RunningInBlazorHybrid="true"
				SearchTermParameter="@searchTerm" CloseApplication="CloseWindow" MaximizeApplication="MaximizeWindow" />
		}
	</div>
</CascadingBlazoredModal>
