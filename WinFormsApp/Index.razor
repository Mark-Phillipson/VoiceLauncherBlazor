@page "/"
@using System.Diagnostics;
@using RazorClassLibrary.Pages
<CascadingBlazoredModal>
	<div class='m-2 text-center'>
		<details class="d-inline-block me-2 mb-1">
			<summary class="btn btn-sm btn-outline-secondary">Window</summary>
			<div class="btn-group-vertical mt-1">
				<button accesskey="/" class="btn btn-sm btn-outline-secondary text-start" @onclick="@(() => MaximizeWindow())"><u>/</u> Maximize</button>
				<button accesskey="_" class="btn btn-sm btn-outline-secondary text-start" @onclick="@(() => MinimizeWindow())"><u>_</u> Minimize</button>
				<button accesskey="*" class="btn btn-sm btn-outline-secondary text-start" @onclick="@(() => RestoreWindow())"><u>*</u> Restore</button>
			</div>
		</details>
		<details class="d-inline-block me-2 mb-1">
			<summary class="btn btn-sm btn-outline-info">Data</summary>
			<div class="btn-group-vertical mt-1">
				<button class="btn btn-sm btn-outline-info text-start" @onclick="@(() => RefreshCache())">
					<i class="bi bi-arrow-repeat"></i> Refresh Data
				</button>
				<button class="btn btn-sm btn-outline-secondary text-start" @onclick="@(() => ShowClipboardHistory())">Clipboard History</button>
			</div>
		</details>
		<details class="d-inline-block mb-1">
			<summary class="btn btn-sm btn-outline-primary">Views</summary>
			<div class="btn-group-vertical mt-1">
				<button accesskey="A" class="btn btn-sm btn-outline-primary text-start" @onclick="@(() => ShowAIChat())"><u>A</u>I @AIChatButtonCaption</button>
				@* Top-level switch buttons: show only the relevant toggle depending on current view *@
				@if (launcher)
				{
					<button accesskey="!" class="btn btn-sm btn-outline-secondary text-start" @onclick="SwitchToSnippetsFromChild"><i class="bi bi-box-arrow-up-right"></i> Snippets (!)</button>
				}
				else if (languageAndCategoryListing)
				{
					<button accesskey="!" class="btn btn-sm btn-outline-secondary text-start" @onclick="SwitchToLauncherFromChild"><i class="bi bi-box-arrow-up-right"></i> Launcher (!)</button>
				}
				else
				{
					<button class="btn btn-sm btn-outline-secondary text-start" @onclick="SwitchToSnippetsFromChild">Snippets</button>
					<button class="btn btn-sm btn-outline-secondary text-start" @onclick="SwitchToLauncherFromChild">Launcher</button>
				}
				<button class="btn btn-sm btn-outline-success text-start" @onclick="@(() => ShowTalonSearch())">@TalonSearchButtonCaption</button>
			</div>
		</details>
	</div>
	<div class='m-2'>
		@if (showAIChat)
		{
			<AIChatComponent RunningInBlazorHybrid="true" />
		}		else if (showTalonSearch)
		{
			<TalonVoiceCommandSearch IsBlazorHybrid="true" InitialSearchTerm="@searchTerm" />
		}
		else if (showClipboardHistory)
		{
			<ClipboardHistory />
		}
			else if (languageAndCategoryListing)
		{
			<CustomIntelliSenseTable @ref="customIntelliSenseTableRef" CategoryId="@categoryId" LanguageId="@languageId" RunningInBlazorHybrid="true"
				CloseApplication="CloseWindow" MaximizeApplication="MaximizeWindow" />
		}
			else if (launcher)
		{
			<LauncherTable @ref="launcherTableRef" CategoryId="@categoryId" CloseApplication="CloseWindow" RunningInBlazorHybrid="true"
				RefreshData="@refreshRequested" />
		}
		else // filtering by display value mostly
		{
			<CustomIntelliSenses @ref="customIntelliSensesRef" CategoryIdFilter="@categoryId" LanguageIdFilter="@languageId" RunningInBlazorHybrid="true"
				SearchTermParameter="@searchTerm" CloseApplication="CloseWindow" MaximizeApplication="MaximizeWindow" />
		}
	</div>
</CascadingBlazoredModal>
