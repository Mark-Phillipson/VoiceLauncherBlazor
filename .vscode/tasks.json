{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"command": "dotnet build --configuration Release",
			"group": "build",
			"problemMatcher": [
				"error",
				"warning"
			],
			"label": "Run dotnet build Release"
		},
		{
			"type": "shell",
			"command": "dotnet watch --project VoiceAdmin/VoiceAdmin.csproj --urls http://localhost:5008",
			"group": "build",
			"problemMatcher": [],
			"label": "dotnet: watch VoiceAdmin"
		},
		{
			"label": "Run dotnet publish",
			"type": "shell",
			"command": "dotnet publish \"${workspaceFolder}/VoiceAdmin/VoiceAdmin.csproj\" --configuration Release --output \"${workspaceFolder}/publish/VoiceAdmin\"",
			"problemMatcher": []
		},
		{
			"label": "checkAppRunningOnPort7264",
			"type": "shell",
			"command": "powershell.exe -ExecutionPolicy Bypass -File \"${workspaceFolder}/.vscode/check-port.ps1\" -PortNumber 7264",
			"problemMatcher": [],
			"presentation": {
				"reveal": "silent",
				"panel": "shared",
				"clear": true
			}
		},
		{
			"label": "Build and Run WinFormsApp (Debug)",
			"type": "shell",
			"command": "dotnet build --configuration Debug && dotnet run --project WinFormsApp/WinFormsApp.csproj --configuration Debug",
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		}
	]
}