@using System.Linq
@using Blazored.Toast.Services
@using DataAccessLibrary
@using DataAccessLibrary.Configuration
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Data.Sqlite
@using Microsoft.Extensions.Configuration
@using RazorClassLibrary.Models
@using RazorClassLibrary.Services
@using WindowsInput
@using WindowsInput.Native
@inject IClipboardHistoryService ClipboardService
@inject ISqlDataAccess SqlDataAccess
@inject IConfiguration Configuration
@inject IJSRuntime JS
@inject IToastService ToastService

<div class="clipboard-history">
  <div class="mb-2 d-flex align-items-center">
    <input class="form-control me-2" placeholder="Search... (K)" @bind="Search" @onkeydown="HandleSearchKeyDown"
           title="Press Enter to search" accesskey="k" aria-keyshortcuts="K" @ref="searchInputRef" />
    <button class="btn btn-primary me-2" @onclick="SearchAsync" accesskey="s" aria-keyshortcuts="S"
            title="Search (accesskey: S)">Search <kbd class="ms-1">S</kbd></button>
    <button class="btn btn-secondary" @onclick="Refresh" accesskey="r" aria-keyshortcuts="R"
            title="Refresh (accesskey: R)">Refresh <kbd class="ms-1">R</kbd></button>
    <select class="form-select ms-2" style="max-width: 220px;" @bind="SortOrder" @bind:after="SortOrderChanged"
            aria-label="Sort clipboard history">
      <option value="@ClipboardHistorySortOrder.NewestFirst">Sort: Newest first</option>
      <option value="@ClipboardHistorySortOrder.OldestFirst">Sort: Oldest first</option>
    </select>
  </div>

  @if (IsLoading)
  {
    <div class="mb-2 d-flex align-items-center">
      <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
      <span class="ms-2">Loading...</span>
    </div>
  }

  <table class="table table-striped">
    <thead>
      <tr>
        <th class="preview-col">Preview</th>
        <th class="created-col">Created</th>
        <th class="actions-col">Actions</th>
      </tr>
    </thead>
    <tbody>
      @if (Items?.Any() != true)
      {
        <tr>
          <td colspan="3">No entries</td>
        </tr>
      }
      else
      {
        @for (var i = 0; i < Items.Count; i++)
        {
          var item = Items[i];
          var accessKey = AccessKeyMapper.GetKeyForIndex(i);
          var ariaShortcut = !string.IsNullOrEmpty(accessKey) ? AccessKeyMapper.GetAriaKeyShortcuts(accessKey) :
      string.Empty;
          <tr>
            <td class="preview-col">
              @if (item.IsPinned)
              {
                <span class="badge bg-warning text-dark me-1">Pinned</span>
              }
              @(item.Content?.Length > 150 ? item.Content.Substring(0, 150) + "..." : item.Content)
            </td>
            <td class="created-col">@TimeFormatter.FormatTimestamp(item.CreatedAt)</td>
            <td class="actions-col">
              <div class="d-flex gap-1 flex-nowrap align-items-center">
                @if (!string.IsNullOrEmpty(accessKey))
                {
                  <button class="btn btn-sm btn-outline-secondary" @onclick="() => CopyContent(item)" accesskey="@accessKey"
                          aria-keyshortcuts="@ariaShortcut" title="Copy to clipboard (access key: @accessKey)"
                          aria-label="Copy to clipboard. Access key: @accessKey">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-copy"
                         viewBox="0 0 16 16">
                      <path fill-rule="evenodd"
                            d="M4 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1zM2 5a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-1h1v1a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h1v1z" />
                    </svg>
                    <span class="ms-1 copy-kbd"><kbd>@accessKey</kbd></span>
                  </button>
                }
                else
                {
                  <button class="btn btn-sm btn-outline-secondary" @onclick="() => CopyContent(item)"
                          title="Copy to clipboard" aria-label="Copy to clipboard">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-copy"
                         viewBox="0 0 16 16">
                      <path fill-rule="evenodd"
                            d="M4 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1zM2 5a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-1h1v1a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h1v1z" />
                    </svg>
                  </button>
                }
                <button class="btn btn-sm btn-outline-primary" @onclick="() => Edit(item.Id)">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil"
                       viewBox="0 0 16 16">
                    <path
                    d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325" />
                  </svg>
                </button>
                <button class="btn btn-sm btn-outline-warning" @onclick="() => TogglePinned(item)">
                  @if (item.IsPinned)
                  {
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pin"
                         viewBox="0 0 16 16">
                      <path
                      d="M4.146.146A.5.5 0 0 1 4.5 0h7a.5.5 0 0 1 .5.5c0 .68-.342 1.174-.646 1.479-.126.125-.25.224-.354.298v4.431l.078.048c.203.127.476.314.751.555C12.36 7.775 13 8.527 13 9.5a.5.5 0 0 1-.5.5h-4v4.5c0 .276-.224 1.5-.5 1.5s-.5-1.224-.5-1.5V10h-4a.5.5 0 0 1-.5-.5c0-.973.64-1.725 1.17-2.189A6 6 0 0 1 5 6.708V2.277a3 3 0 0 1-.354-.298C4.342 1.674 4 1.179 4 .5a.5.5 0 0 1 .146-.354m1.58 1.408-.002-.001zm-.002-.001.002.001A.5.5 0 0 1 6 2v5a.5.5 0 0 1-.276.447h-.002l-.012.007-.054.03a5 5 0 0 0-.827.58c-.318.278-.585.596-.725.936h7.792c-.14-.34-.407-.658-.725-.936a5 5 0 0 0-.881-.61l-.012-.006h-.002A.5.5 0 0 1 10 7V2a.5.5 0 0 1 .295-.458 1.8 1.8 0 0 0 .351-.271c.08-.08.155-.17.214-.271H5.14q.091.15.214.271a1.8 1.8 0 0 0 .37.282" />
                    </svg>
                  }
                  else
                  {
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pin-angle"
                         viewBox="0 0 16 16">
                      <path
                      d="M9.828.722a.5.5 0 0 1 .354.146l4.95 4.95a.5.5 0 0 1 0 .707c-.48.48-1.072.588-1.503.588-.177 0-.335-.018-.46-.039l-3.134 3.134a6 6 0 0 1 .16 1.013c.046.702-.032 1.687-.72 2.375a.5.5 0 0 1-.707 0l-2.829-2.828-3.182 3.182c-.195.195-1.219.902-1.414.707s.512-1.22.707-1.414l3.182-3.182-2.828-2.829a.5.5 0 0 1 0-.707c.688-.688 1.673-.767 2.375-.72a6 6 0 0 1 1.013.16l3.134-3.133a3 3 0 0 1-.04-.461c0-.43.108-1.022.589-1.503a.5.5 0 0 1 .353-.146m.122 2.112v-.002zm0-.002v.002a.5.5 0 0 1-.122.51L6.293 6.878a.5.5 0 0 1-.511.12H5.78l-.014-.004a5 5 0 0 0-.288-.076 5 5 0 0 0-.765-.116c-.422-.028-.836.008-1.175.15l5.51 5.509c.141-.34.177-.753.149-1.175a5 5 0 0 0-.192-1.054l-.004-.013v-.001a.5.5 0 0 1 .12-.512l3.536-3.535a.5.5 0 0 1 .532-.115l.096.022c.087.017.208.034.344.034q.172.002.343-.04L9.927 2.028q-.042.172-.04.343a1.8 1.8 0 0 0 .062.46z" />
                    </svg>
                  }
                  
                </button>
                <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(item.Id)">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-x-square"
                       viewBox="0 0 16 16">
                    <path
                    d="M14 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1zM2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2z" />
                    <path
                    d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708" />
                  </svg>
                </button>
              </div>
            </td>
          </tr>
        }
      }
    </tbody>
  </table>
  
  @if (!string.IsNullOrEmpty(DiagnosticsMessage))
  {
    <div class="alert alert-warning mt-3" role="alert">
      <strong>Diagnostics:</strong>
      <div>@DiagnosticsMessage</div>
      @if (!string.IsNullOrEmpty(SchemaInfo))
      {
        <div><strong>Schema:</strong> @SchemaInfo</div>
      }
    </div>
  }

  <div class="d-flex justify-content-between align-items-center">
    <div>Showing page @Page (@TotalCount entries)</div>
    <div>
      <button class="btn btn-sm btn-outline-secondary me-1" @onclick="PrevPage" disabled="@(!CanPrev)">Prev</button>
      <button class="btn btn-sm btn-outline-secondary" @onclick="NextPage" disabled="@(!CanNext)">Next</button>
    </div>
  </div>

  @if (Editing)
  {
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Edit Clipboard Entry</h5>
            <button type="button" class="btn-close" @onclick="CancelEdit"></button>
          </div>
          <div class="modal-body">
            <textarea class="form-control" rows="8" @bind="EditingContent"></textarea>
          </div>
          <div class="modal-footer">
            <button class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
            <button class="btn btn-primary" @onclick="SaveEdit">Save</button>
          </div>
        </div>
      </div>
    </div>
  }

</div>

@code {
  private List<ClipboardEntry> Items = new();
  private int Page = 1;
  private int PageSize = 25;
  private int TotalCount = 0;
  private string Search = string.Empty;
  private bool Editing = false;
  private long? EditingId;
  private string EditingContent = string.Empty;
  private bool IsLoading = false;
  private ClipboardHistorySortOrder SortOrder = ClipboardHistorySortOrder.NewestFirst;
  private string DiagnosticsMessage = string.Empty;
  private string EffectiveConnectionString = string.Empty;
  private string SchemaInfo = string.Empty;
  private ElementReference searchInputRef;
  private bool _searchFocused = false;
    
  private async Task HandleSearchKeyDown(KeyboardEventArgs e)
  {
    if (e?.Key == "Enter")
    {
      Page = 1;
      await LoadPage();
    }
  }

  private async Task CopyContent(ClipboardEntry item)
  {
    try
    {
      var txt = item?.Content ?? string.Empty;
      if (string.IsNullOrWhiteSpace(txt))
      {
        ToastService?.ShowWarning("Nothing to copy");
        return;
      }
      await JS.InvokeVoidAsync("navigator.clipboard.writeText", txt);
      InputSimulator simulator = new InputSimulator();
      simulator.Keyboard.ModifiedKeyStroke(VirtualKeyCode.MENU, VirtualKeyCode.TAB);
      simulator.Keyboard.Sleep(300);
      simulator.Keyboard.KeyPress(VirtualKeyCode.RETURN);


      ToastService?.ShowSuccess("Copied to clipboard");
    }
    catch (Exception ex)
    {
      ToastService?.ShowError("Copy failed: " + ex.Message);
    }
  }

  protected override async Task OnInitializedAsync()
  {
    await LoadPage();
  }

  private async Task LoadPage()
  {
    IsLoading = true;
    DiagnosticsMessage = string.Empty;
    try
    {
      // Use the clipboard-specific connection string if configured
      var clipboardConn = Configuration.GetConnectionString("ClipboardHistory");
      EffectiveConnectionString = DataAccessLibrary.Configuration.DatabaseConfiguration.GetConnectionString(clipboardConn);

      // Attempt to read the table schema directly for diagnostics
      try
      {
        SchemaInfo = string.Empty;
        using var conn = new SqliteConnection(EffectiveConnectionString);
        await conn.OpenAsync();
        using var cmd = conn.CreateCommand();
        cmd.CommandText = "PRAGMA table_info('ClipboardHistory');";
        using var reader = await cmd.ExecuteReaderAsync();
        var cols = new List<string>();
        while (await reader.ReadAsync())
        {
          // PRAGMA table_info columns: cid, name, type, notnull, dflt_value, pk
          var colName = reader.IsDBNull(1) ? "" : reader.GetString(1);
          var colType = reader.IsDBNull(2) ? "" : reader.GetString(2);
          cols.Add(colName + "(" + colType + ")");
        }
        if (cols.Any()) SchemaInfo = string.Join(", ", cols);
      }
      catch (Exception exSchema)
      {
        SchemaInfo = "(schema read error: " + exSchema.Message + ")";
      }

      var res = await ClipboardService.QueryAsync(Page, PageSize, Search, null, null, SortOrder);
      Items = res.Items.ToList();
      TotalCount = res.TotalCount;

      if (TotalCount == 0)
      {
        DiagnosticsMessage = $"Table 'ClipboardHistory' present but contains no rows. Connection: {EffectiveConnectionString}";
      }
      else
      {
        DiagnosticsMessage = $"Loaded {TotalCount} rows from ClipboardHistory. Connection: {EffectiveConnectionString}";
      }
    }
    catch (Exception ex)
    {
      DiagnosticsMessage = "Error loading clipboard entries (table missing or DB error): " + ex.Message + $". Connection: {EffectiveConnectionString}";
      Items = new List<ClipboardEntry>();
      TotalCount = 0;
    }
    finally
    {
      IsLoading = false;
      StateHasChanged();
    }
  }

  private async Task SearchAsync()
  {
    Page = 1;
    await LoadPage();
  }

  private async Task Refresh()
  {
    // Clear any active search filter and reload the first page
    Search = string.Empty;
    Page = 1;
    await LoadPage();
    // Ensure keyboard focus returns to the search box
    try
    {
      await searchInputRef.FocusAsync();
    }
    catch
    {
      // ignore focus errors (prerender or unsupported)
    }
  }

  private async Task SortOrderChanged()
  {
    Page = 1;
    await LoadPage();
  }

  private async Task TogglePinned(ClipboardEntry item)
  {
    await ClipboardService.SetPinnedAsync(item.Id, !item.IsPinned);
    await LoadPage();
  }

  private async Task Edit(long id)
  {
    var item = await ClipboardService.GetAsync(id);
    if (item != null)
    {
      EditingId = id;
      EditingContent = item.Content ?? string.Empty;
      Editing = true;
    }
  }

  private async Task SaveEdit()
  {
    if (EditingId.HasValue)
    {
      await ClipboardService.UpdateAsync(new ClipboardEntry { Id = EditingId.Value, Content = EditingContent });
      Editing = false;
      EditingId = null;
      await LoadPage();
    }
  }

  private void CancelEdit()
  {
    Editing = false;
    EditingId = null;
  }

  private async Task Delete(long id)
  {
    await ClipboardService.DeleteAsync(id);
    await LoadPage();
  }

  private bool CanPrev => Page > 1;
  private bool CanNext => Page * PageSize < TotalCount;

  private async Task PrevPage()
  {
    if (CanPrev) { Page--; await LoadPage(); }
  }

  private async Task NextPage()
  {
    if (CanNext) { Page++; await LoadPage(); }
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender && !_searchFocused)
    {
      try
      {
        await searchInputRef.FocusAsync();
        _searchFocused = true;
      }
      catch
      {
        // ignore focus errors (server prerender or unsupported)
      }
    }
  }
}
