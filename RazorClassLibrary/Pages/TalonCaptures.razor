    private string GetCustomCapturesPath()
    {
        var appData = Environment.GetFolderPath(Environment.SpecialFolder.ApplicationData);
        return System.IO.Path.Combine(appData, "VoiceLauncherBlazor", "TalonCaptures.custom.md");
    }

    private void BeginAddCapture()
    {
        IsEditingCapture = false;
        EditingCaptureName = string.Empty;
        NewCaptureName = string.Empty;
        NewCaptureType = "capture";
        NewCaptureRule = string.Empty;
        AddCaptureError = string.Empty;
        ShowAddCapture = true;
    }

    private void BeginEditCapture(CaptureEntry capture)
    {
        IsEditingCapture = true;
        EditingCaptureName = capture.Name;
        NewCaptureName = capture.Name;
        NewCaptureType = capture.Type;
        NewCaptureRule = GetEditableRule(capture);
        AddCaptureError = string.Empty;
        ShowAddCapture = true;
    }

    private void CancelCaptureEdit()
    {
        ShowAddCapture = false;
        IsEditingCapture = false;
        EditingCaptureName = string.Empty;
        AddCaptureError = string.Empty;
    }

    private static string GetEditableRule(CaptureEntry capture)
    {
        var match = System.Text.RegularExpressions.Regex.Match(
            capture.MarkdownSnippet ?? string.Empty,
            @"^\s*-\s*Rule:\s*(?<rule>.*)$",
            System.Text.RegularExpressions.RegexOptions.Multiline | System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        if (match.Success)
        {
            var value = System.Net.WebUtility.HtmlDecode(match.Groups["rule"].Value);
            value = System.Text.RegularExpressions.Regex.Replace(value, @"<br\s*/?>", Environment.NewLine, System.Text.RegularExpressions.RegexOptions.IgnoreCase);
            return value.Trim();
        }

        return GetDescription(capture);
    }

    private async Task SaveCaptureAsync()
    {
        var name = (NewCaptureName ?? string.Empty).Trim();
        var type = (NewCaptureType ?? string.Empty).Trim();
        var rule = (NewCaptureRule ?? string.Empty).Trim();

        if (string.IsNullOrWhiteSpace(name))
        {
            AddCaptureError = "Enter a capture or list name.";
            return;
        }

        if (!System.Text.RegularExpressions.Regex.IsMatch(name, @"^[A-Za-z0-9_.-]+$"))
        {
            AddCaptureError = "Use only letters, numbers, dots, underscores, or hyphens in the capture name.";
            return;
        }

        if (string.IsNullOrWhiteSpace(type))
        {
            AddCaptureError = "Enter a type, such as capture or list.";
            return;
        }

        if (string.IsNullOrWhiteSpace(rule))
        {
            AddCaptureError = "Enter a rule or description.";
            return;
        }

        var exists = captures.Any(c => string.Equals(c.Name, name, StringComparison.OrdinalIgnoreCase));
        if (!IsEditingCapture && exists)
        {
            AddCaptureError = $"'{name}' is already in the cheatsheet. Use Edit to update it.";
            return;
        }

        if (IsEditingCapture && !string.Equals(name, EditingCaptureName, StringComparison.OrdinalIgnoreCase))
        {
            AddCaptureError = "The capture name cannot be changed while editing.";
            return;
        }

        var anchor = System.Text.RegularExpressions.Regex.Replace(name.ToLowerInvariant(), "[^a-z0-9_-]", "-");
        var safeRule = System.Net.WebUtility.HtmlEncode(rule)
            .Replace("\r\n", "<br />").Replace("\n", "<br />").Replace("\r", "<br />");
        var entry = $"## Personal entries{Environment.NewLine}{Environment.NewLine}- [{name}](#{anchor}) ({type}){Environment.NewLine}  - Rule: {safeRule}{Environment.NewLine}{Environment.NewLine}";

        try
        {
            var path = GetCustomCapturesPath();
            var directory = System.IO.Path.GetDirectoryName(path);
            if (!string.IsNullOrWhiteSpace(directory))
            {
                System.IO.Directory.CreateDirectory(directory);
            }

            await System.IO.File.AppendAllTextAsync(path, entry);
            rawMarkdown = string.Concat(rawMarkdown, Environment.NewLine, entry);
            ParseMarkdown(rawMarkdown);
            await ResolveListValuesAsync();

            SearchTerm = name;
            NewCaptureName = string.Empty;
            NewCaptureRule = string.Empty;
            NewCaptureType = "capture";
            AddCaptureError = string.Empty;
            ShowAddCapture = false;
            IsEditingCapture = false;
            EditingCaptureName = string.Empty;
        }
        catch (Exception ex)
        {
            AddCaptureError = $"Could not save the custom entry: {ex.Message}";
        }
    }

    private string GetDetailsContainerId(string anchor)
    {
        if (string.IsNullOrWhiteSpace(anchor)) return "talon-captures-markdown-container";
        var safe = System.Text.RegularExpressions.Regex.Replace(anchor, "[^A-Za-z0-9\\-_]", "-");
        return "talon-captures-markdown-" + safe;
    }

    private class CaptureEntry
    {
        public string Name { get; set; } = string.Empty;
        public string Anchor { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty;
        // Full original markdown snippet (used for parsing lists/matches)
        public string MarkdownSnippet { get; set; } = string.Empty;
        // Sanitized snippet for display (Actions: blocks removed)
        public string SanitizedSnippet { get; set; } = string.Empty;
        public Dictionary<string, List<string>> ReferencedLists { get; set; } = new();
        public List<string> InlineMatches { get; set; } = new();
    }
