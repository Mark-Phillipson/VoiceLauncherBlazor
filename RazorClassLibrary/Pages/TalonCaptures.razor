    private static string GetDescription(CaptureEntry capture)
    {
        return CaptureDescriptions.TryGetValue(capture.Name, out var description)
            ? description
            : string.Empty;
    }

    private sealed class CaptureUsageExample
    {
        public string Rule { get; init; } = string.Empty;
        public string SpokenPhrase { get; init; } = string.Empty;
        public string Result { get; init; } = string.Empty;
        public string Note { get; init; } = string.Empty;
    }

    // Only add examples where the capture's purpose and expected value are clear.
    // These are illustrative command rules; the action after the rule is application-specific.
    private static readonly Dictionary<string, CaptureUsageExample> CaptureUsageExamples = new(StringComparer.OrdinalIgnoreCase)
    {
        ["user.address"] = new()
        {
            Rule = "go to <user.address>",
            SpokenPhrase = "Go to GitHub",
            Result = "The URL configured for the spoken website name (for example, https://github.com)",
            Note = "In a browser, this capture matches a configured website from user.website. The user.address tag also enables commands such as “address bar” and “address copy”. In a file manager, the same capture name instead matches a system path."
        },
        ["user.text"] = new()
        {
            Rule = "enter <user.text>",
            SpokenPhrase = "Enter hello comma how are you question mark",
            Result = "Hello, how are you?",
