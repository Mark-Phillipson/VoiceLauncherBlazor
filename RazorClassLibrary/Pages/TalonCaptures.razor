    {
        ["user.abbreviation"] = "Matches a configured abbreviation after the spoken word “brief”.",
        ["user.address"] = "Context-sensitive capture: in a browser it captures a configured website address (URL); in a file manager it captures a system file or folder path. The user.address tag enables related address commands in supported applications.",
        ["user.any_alphanumeric_key"] = "Matches a single letter, number, or symbol key.",
        ["user.arrow_key"] = "Matches one arrow key from the configured arrow-key list.",
        ["user.arrow_keys"] = "Matches one or more arrow keys, for example as part of a keyboard shortcut.",
        ["user.c_cast"] = "Builds a C cast type, including optional signedness and pointer annotations.",
        ["user.c_fixed_integer"] = "Matches a fixed-width C integer type, such as uint32_t.",
