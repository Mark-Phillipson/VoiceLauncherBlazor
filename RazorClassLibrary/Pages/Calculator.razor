@page "/calculator"
@using System.Globalization
@inject IJSRuntime JS

<h3>Calculator</h3>

<div class="row mb-3 g-3">
    <div class="col-12 col-md-4">
        <label class="form-label" for="firstNumber">First number <kbd>1</kbd></label>
        <input id="firstNumber" class="form-control" type="number" step="any" @bind="Left" aria-label="First number" @ref="firstNumberInput" accesskey="1" />
    </div>
    <div class="col-12 col-md-4">
        <label class="form-label" for="secondNumber">Second number <kbd>2</kbd></label>
        <input id="secondNumber" class="form-control" type="number" step="any" @bind="Right" aria-label="Second number" accesskey="2" />
    </div>
    <div  class="col-12 col-md-4">
        <label class="form-label" for="resultText">Result <kbd>3</kbd></label>
     <input id="resultText" class="form-control" accesskey="3" type="number" step="any" @bind="ResultText" aria-label="Result" />
    <span> @CopyStatus</span>
</div>
</div>

<div class="mb-3 calculator-buttons">
    <button class="btn btn-primary me-2" @onclick="Add" accesskey="A" aria-label="Add (Alt+A)">➕ Add <kbd>A</kbd></button>
    <button class="btn btn-light me-2" @onclick="Subtract" accesskey="S" aria-label="Subtract (Alt+S)">➖ Subtract <kbd>S</kbd></button>
    <button class="btn btn-success me-2" @onclick="Multiply" accesskey="M" aria-label="Multiply (Alt+M)">✖️ Multiply <kbd>M</kbd></button>
    <button class="btn btn-danger me-2" @onclick="Divide" accesskey="V" aria-label="Divide (Alt+V)">➗ Divide <kbd>V</kbd></button>
    @if (!string.IsNullOrEmpty(ResultText))
    {
        <button class="btn btn-outline-info btn-sm me-2 mt-2" @onclick="CopyResult" accesskey="R" aria-label="Copy result (Alt+R)" >📋 Copy <kbd>R</kbd></button>
        <button class="btn btn-outline-warning btn-sm me-2 mt-2" @onclick="ClearAll" accesskey="L" aria-label="Clear numbers (Alt+L)">🧹 Clear <kbd>L</kbd></button>
    }
</div>
<br /><br />
<h4>History</h4>
<ul>
    @foreach (var item in History)
    {
        <li>@item.Left @(" " + (item.ResultText.Contains("Error") ? "" : (item.Operation == "+" ? "➕" : item.Operation == "-" ? "➖" : item.Operation == "*" ? "✖️" : item.Operation == "/" ? "➗" : ""))) @item.Right = @item.ResultText</li>
    }
</ul>




@code {
    private double Left { get; set; }
    private double Right { get; set; }
    private string ResultText { get; set; } = string.Empty;
    private ElementReference firstNumberInput;
    private string CopyStatus { get; set; } = string.Empty;

    private class CalculatorHistory
    {
        public double Left { get; set; }
        public double Right { get; set; }
        public string ResultText { get; set; } = string.Empty;
        public string Operation { get; set; } = string.Empty;
    }
    private List<CalculatorHistory> History { get; set; } = new List<CalculatorHistory>();
    private void Add()
    {
        ResultText = (Left + Right).ToString(CultureInfo.CurrentCulture);
        History.Add(new CalculatorHistory { Left = Left, Right = Right, ResultText = ResultText, Operation = "+" });
    }
    private void Subtract()
    {
        ResultText = (Left - Right).ToString(CultureInfo.CurrentCulture);
        History.Add(new CalculatorHistory { Left = Left, Right = Right, ResultText = ResultText, Operation = "-" });
    }
    private void Multiply()
    {
        ResultText = (Left * Right).ToString(CultureInfo.CurrentCulture);
        History.Add(new CalculatorHistory { Left = Left, Right = Right, ResultText = ResultText, Operation = "*" });
    }
    private void Divide()
    {
        if (Right == 0)
        {
            ResultText = "Error: Division by zero";
            return;
        }
        ResultText = (Left / Right).ToString(CultureInfo.CurrentCulture);
        History.Add(new CalculatorHistory { Left = Left, Right = Right, ResultText = ResultText, Operation = "/" });
    }

    private async Task CopyResult()
    {
        if (string.IsNullOrEmpty(ResultText))
        {
            return;
        }
        try
        {
            await JS.InvokeVoidAsync("clipboardCopy.copyText", ResultText);
            CopyStatus = "Copied to clipboard";
        }
        catch
        {
            CopyStatus = "Copy failed";
        }
        // briefly show status
        StateHasChanged();
        await Task.Delay(1500);
        CopyStatus = string.Empty;
        StateHasChanged();
    }

    private async Task ClearAll()
    {
        Left = 0;
        Right = 0;
        ResultText = 0.ToString(CultureInfo.CurrentCulture);
        CopyStatus = string.Empty;
        // Ensure the UI updates before attempting to focus the input.
        await InvokeAsync(StateHasChanged);
        // Yield so the browser can apply the DOM updates (helps ensure selection works).
        await Task.Yield();
        try
        {
            await firstNumberInput.FocusAsync();
            //await JS.InvokeVoidAsync("setFocus", firstNumberInput);
        }
        catch
        {
            // ignore JS errors
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await firstNumberInput.FocusAsync();    
            }
            catch
            {
                // ignore JS errors
            }
        }
    }
}
