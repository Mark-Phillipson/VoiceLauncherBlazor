@page "/cursorless-quiz"

<PageTitle>Cursorless Quiz</PageTitle>

<div class="quiz-shell" tabindex="0" @onkeydown="HandleKeyDown">
    <div class="quiz-card">
        <div class="quiz-header">
            <div>
                <h1 class="quiz-title">Cursorless Quiz</h1>
                <p class="quiz-subtitle">Keyboard-first practice for the cheatsheet and docs.</p>
            </div>
            @if (!_quizActive)
            {
                <div class="quiz-badge">Ready</div>
            }
        </div>

        @if (_isLoadingHistory)
        {
            <div class="quiz-panel">
                <p>Loading your quiz history...</p>
            </div>
        }
        else if (!_quizActive && !_showingResults)
        {
            <div class="quiz-grid">
                <section class="quiz-panel">
                    <h2>Start a quiz</h2>
                    <p>Choose a length, then press Start or use the S access key.</p>

                    <label class="quiz-label" for="question-count">Questions</label>
                    <select id="question-count" class="form-select quiz-select" @bind="QuestionCount">
                        <option value="5">5</option>
                        <option value="10">10</option>
                        <option value="15">15</option>
                        <option value="20">20</option>
                    </select>

                    <div class="quiz-actions quiz-start-actions">
                        <button type="button" class="btn btn-primary" accesskey="s" @onclick="StartQuizAsync"><kbd class="quiz-kbd">S</kbd> Start quiz</button>
                    </div>
                </section>

                <section class="quiz-panel">
                    <h2>Recent scores</h2>
                    @if (_scoreHistory.Count == 0)
                    {
                        <p>No scores yet. Finish a quiz to build your history.</p>
                    }
                    else
                    {
                        <ul class="quiz-score-list">
                            @foreach (var score in _scoreHistory.Take(5))
                            {
                                <li>
                                    <strong>@score.CorrectAnswers / @score.TotalQuestions</strong>
                                    <span>@score.PlayedAt.ToLocalTime().ToString("g")</span>
                                </li>
                            }
                        </ul>
                    }
                </section>
            </div>
        }
        else if (_quizActive && CurrentQuestion is not null)
        {
            <div class="quiz-panel quiz-play-panel">
                <div class="quiz-meta-row">
                    <span>Score: @_correctAnswers / @_currentQuestionIndex</span>
                    <span>Source: @CurrentQuestion.Source</span>
                    @if (!string.IsNullOrWhiteSpace(CurrentQuestion.DocLink))
                    {
                        <span>
                            <a href="@CurrentQuestion.DocLink" target="_blank" rel="noopener noreferrer">
                                @((CurrentQuestion.Category != null && CurrentQuestion.Category.IndexOf("shape", StringComparison.OrdinalIgnoreCase) >= 0) ? "Shape documentation" : "Docs")
                            </a>
                        </span>
                    }
                    <span>Category: @CurrentQuestion.Category</span>
                </div>

                <div class="quiz-prompt-row">
                    <h2 class="quiz-prompt">@CurrentQuestion.Prompt</h2>
                </div>

                @if (!string.IsNullOrWhiteSpace(CurrentQuestion.Image))
                {
                    <div class="quiz-question-image">
                        <img src="@((CurrentQuestion.Image.StartsWith("/") ? "" : "/") + CurrentQuestion.Image)" alt="question image" />
                    </div>
                }

                <div class="quiz-choices" role="list" aria-label="Answer choices">
                            <div class="quiz-choices-header">
                                <div class="quiz-badge quiz-badge--panel">@($"Question {_currentQuestionIndex + 1} / {_questions.Count}")</div>
                            </div>
                    @for (var index = 0; index < CurrentQuestion.Choices.Count; index++)
                    {
                        var choiceIndex = index;
                        var choiceText = CurrentQuestion.Choices[choiceIndex];
                        string? choiceImage = null;
                        if (CurrentQuestion.ChoiceImagePaths != null && CurrentQuestion.ChoiceImagePaths.Count > choiceIndex)
                        {
                            choiceImage = CurrentQuestion.ChoiceImagePaths[choiceIndex];
                        }

                        <button type="button"
                                class="quiz-choice btn btn-outline-secondary"
                                accesskey="@GetChoiceAccessKey(choiceIndex)"
                                @onclick="() => SubmitAnswerAsync(choiceIndex)">
                            <kbd class="quiz-kbd">@GetChoiceAccessKey(choiceIndex)</kbd>
                            @if (!string.IsNullOrWhiteSpace(choiceImage))
                            {
                                <div class="quiz-choice-media">
                                    <img src="@((choiceImage.StartsWith("/") ? "" : "/") + choiceImage)" alt="@choiceText" class="quiz-choice-thumb" />
                                    <div class="quiz-choice-text">@choiceText</div>
                                </div>
                            }
                            else
                            {
                                <span class="quiz-choice-text">@choiceText</span>
                            }
                        </button>
                    }
                </div>

                <div class="quiz-actions quiz-actions-spread quiz-actions-compact">
                    <button type="button" class="btn btn-outline-danger" accesskey="q" @onclick="QuitQuizAsync"><kbd class="quiz-kbd">Q</kbd> Quit</button>
                    <div class="quiz-shortcuts">1-4 answer</div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_feedbackMessage))
                {
                    <div class="quiz-feedback @( _lastAnswerCorrect ? "quiz-feedback-success" : "quiz-feedback-error")">
                        @_feedbackMessage
                    </div>

                    <div class="quiz-actions">
                        <button type="button" class="btn btn-outline-light" accesskey="n" @onclick="ContinueAfterFeedbackAsync"><kbd class="quiz-kbd">N</kbd> Next</button>
                        <div class="quiz-shortcuts">Press Enter, Space, or N to continue</div>
                    </div>
                }
            </div>
        }
        else if (_showingResults)
        {
            <div class="quiz-panel quiz-results-panel">
                <h2>Quiz complete</h2>
                <p class="quiz-results-score">@_correctAnswers / @_questions.Count correct</p>
                <p>Your score has been saved for later review.</p>

                <div class="quiz-actions">
                    <button type="button" class="btn btn-primary" accesskey="p" @onclick="StartQuizAsync"><kbd class="quiz-kbd">P</kbd> Play again</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="ResetToStartAsync">Back to start</button>
                </div>
            </div>
        }
    </div>
</div>