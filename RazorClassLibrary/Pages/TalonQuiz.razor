@page "/talon-quiz"
@using RazorClassLibrary.Shared
@using RazorClassLibrary.Models
@using DataAccessLibrary.Models
@using Microsoft.AspNetCore.Hosting
@using System.IO
@using System.Text.Json
@inject RazorClassLibrary.Services.ITalonListDataService TalonListDataService
@inject IWebHostEnvironment Env

<div class="mb-3 d-flex gap-2 align-items-center">
    <label class="mb-0">Export quiz pack</label>
    <select id="export-pack-select" class="form-select d-inline-block" style="width: 20rem;">
        <option value="">All Talon Lists</option>
        @foreach (var p in _listNames)
        {
            <option value="@p">@p</option>
        }
    </select>
    <button type="button" class="btn btn-outline-primary" onclick="exportTalonPack()">Export pack</button>
    <div id="exportMessage" class="text-muted ms-2">@(_exportMessage ?? string.Empty)</div>
    <div id="exportedPackLink">@if (!string.IsNullOrWhiteSpace(_exportedPackUrl)) { <a href="@_exportedPackUrl" target="_blank">Open exported pack</a> }</div>
</div>

<GenericQuiz Title="Talon Voice Commands Quiz"
             Subtitle="Keyboard-first practice for Talon list category packs."
             ScoreStorageKey="talonQuizScores"
             GenerateQuestions="GenerateTalonQuestionsAsync"
             AvailablePacks="@_listNames"
             DefaultQuestionCount="10" />

@code {
    private List<TalonList> _allItems = new();
    private List<string> _listNames = new();

    // Export UI state
    private string? _exportedPackUrl;
    private string? _exportMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var items = (await TalonListDataService.GetAllTalonListsAsync())
                .Where(x => !string.IsNullOrWhiteSpace(x.ListName)
                    && !string.IsNullOrWhiteSpace(x.SpokenForm)
                    && !string.IsNullOrWhiteSpace(x.ListValue))
                .ToList();

            _allItems = items;
            _listNames = items
                .Select(x => x.ListName.Trim())
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(x => x)
                .ToList();
        }
        catch
        {
            _allItems = new List<TalonList>();
            _listNames = new List<string>();
        }
    }

    private Task<IReadOnlyList<QuizQuestion>> GenerateTalonQuestionsAsync(int count, string? packName)
    {
        var pool = string.IsNullOrWhiteSpace(packName)
            ? _allItems
            : _allItems.Where(x => string.Equals(x.ListName, packName, StringComparison.OrdinalIgnoreCase)).ToList();

        var distinctFacts = pool
            .DistinctBy(x => new { Name = x.ListName.Trim(), Spoken = x.SpokenForm.Trim(), Value = x.ListValue.Trim() })
            .ToList();

        if (distinctFacts.Count == 0)
        {
            return Task.FromResult((IReadOnlyList<QuizQuestion>)Array.Empty<QuizQuestion>());
        }

        var chosen = distinctFacts.OrderBy(_ => Random.Shared.Next()).Take(Math.Min(count, distinctFacts.Count)).ToList();
        var questions = chosen.Select(f => BuildQuestion(f, distinctFacts)).ToList();
        return Task.FromResult((IReadOnlyList<QuizQuestion>)questions);
    }

    private QuizQuestion BuildQuestion(TalonList fact, IReadOnlyList<TalonList> facts)
    {
        var correctAnswer = fact.ListValue.Trim();

        var sameListDistractors = facts
            .Where(x => !ReferenceEquals(x, fact)
                && string.Equals(x.ListName, fact.ListName, StringComparison.OrdinalIgnoreCase)
                && !string.Equals(x.ListValue, correctAnswer, StringComparison.OrdinalIgnoreCase))
            .Select(x => x.ListValue.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(_ => Random.Shared.Next())
            .Take(3)
            .ToList();

        var distractors = sameListDistractors;
        if (distractors.Count < 3)
        {
            var additional = facts
                .Where(x => !string.Equals(x.ListValue, correctAnswer, StringComparison.OrdinalIgnoreCase))
                .Select(x => x.ListValue.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Except(distractors, StringComparer.OrdinalIgnoreCase)
                .OrderBy(_ => Random.Shared.Next())
                .Take(3 - distractors.Count);

            distractors = distractors.Concat(additional).ToList();
        }

        var choices = distractors.Append(correctAnswer)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(_ => Random.Shared.Next())
            .Take(4)
            .ToList();

        if (!choices.Contains(correctAnswer, StringComparer.OrdinalIgnoreCase))
        {
            if (choices.Count == 4)
            {
                choices[0] = correctAnswer;
            }
            else
            {
                choices.Add(correctAnswer);
            }
        }

        return new QuizQuestion
        {
            Prompt = $"In list '{fact.ListName}', what value matches spoken form '{fact.SpokenForm}'?",
            Choices = choices,
            CorrectAnswer = correctAnswer,
            CorrectIndex = choices.FindIndex(x => string.Equals(x, correctAnswer, StringComparison.OrdinalIgnoreCase)),
            Category = fact.ListName,
            Source = "talon"
        };
    }

    private async Task ExportPackAsync(string? packName)
    {
        try
        {
            var pool = string.IsNullOrWhiteSpace(packName)
                ? _allItems
                : _allItems.Where(x => string.Equals(x.ListName, packName, StringComparison.OrdinalIgnoreCase)).ToList();

            var entries = pool
                .Select(x => new
                {
                    listName = x.ListName,
                    spokenForm = x.SpokenForm,
                    listValue = x.ListValue,
                    sourceFile = x.SourceFile,
                    importedAt = x.ImportedAt
                })
                .ToList();

            var cleanPack = string.IsNullOrWhiteSpace(packName) ? "all" : string.Join("-", packName.Split(Path.GetInvalidFileNameChars()));
            var fileName = $"talon-pack-{cleanPack}-{DateTime.UtcNow:yyyyMMddHHmmss}.json";

            var packObj = new
            {
                packId = $"talon-{DateTime.UtcNow:yyyyMMddHHmmss}",
                packName = cleanPack,
                createdAt = DateTime.UtcNow,
                generator = "TalonExport",
                entries = entries
            };

            var webRootPath = !string.IsNullOrWhiteSpace(Env.WebRootPath) ? Env.WebRootPath : Path.Combine(Env.ContentRootPath, "wwwroot");
            var dir = Path.Combine(webRootPath, "quiz-packs");
            Directory.CreateDirectory(dir);
            var filePath = Path.Combine(dir, fileName);

            var options = new JsonSerializerOptions { WriteIndented = true };
            await File.WriteAllTextAsync(filePath, JsonSerializer.Serialize(packObj, options));

            _exportedPackUrl = $"/quiz-packs/{fileName}";
            _exportMessage = "Export successful";
        }
        catch (Exception ex)
        {
            _exportMessage = $"Export failed: {ex.Message}";
            _exportedPackUrl = null;
        }
    }
}

<script>
    async function exportTalonPack() {
        const sel = document.getElementById('export-pack-select');
        const pack = sel ? sel.value : '';
        const status = document.getElementById('exportMessage');
        const link = document.getElementById('exportedPackLink');
        if (status) status.textContent = 'Exporting...';
        try {
            const res = await fetch('/api/quizpacks/export', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ packName: pack })
            });
            if (!res.ok) {
                const text = await res.text();
                if (status) status.textContent = 'Export failed: ' + res.status + ' ' + (text || res.statusText);
                return;
            }
            const data = await res.json();
            if (status) status.innerHTML = 'Export successful';
            if (link) link.innerHTML = `<a href="${data.url}" target="_blank">Open exported pack</a>`;
        } catch (err) {
            if (status) status.textContent = 'Export failed: ' + err;
        }
    }
</script>
