@page "/clipboard-history"
@using RazorClassLibrary.Components

<h3>Clipboard History</h3>

<ClipboardHistoryViewer IsActive="@IsActive" CloseApplication="@CloseApplication" />
@code {
    [Parameter]
    public bool IsActive { get; set; }=true;
    [Parameter]
    public EventCallback CloseApplication { get; set; }
}
